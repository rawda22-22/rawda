rules_version = '2';

// قواعد Firestore لحجوزات الروضة الشريفة
// انسخ الملف ده كله في: Firebase Console → Firestore Database → Rules → Publish
// ⚠️ غيّر الإيميل اللي في OWNERS لإيميلك انت (اللي بتدخل بيه على الموقع)
service cloud.firestore {
  match /databases/{database}/documents {

    // صاحب الحساب — مدير دايماً حتى لو اتمسح من قائمة الموظفين
    function OWNERS() { return ['khaledalhadedy001@gmail.com']; }

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail()  { return request.auth.token.email.lower(); }
    function isOwner()  { return signedIn() && myEmail() in OWNERS(); }
    function profile()  { return get(/databases/$(database)/documents/users/$(myEmail())).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(myEmail())); }
    function isActive() { return isOwner() || (hasProfile() && profile().active == true); }
    function isAdmin()  { return isOwner() || (isActive() && profile().role == 'admin'); }

    // حسابات الموظفين: المدير بس يضيف ويعدّل، وكل واحد يقرا حسابه
    // والموظف يقدر يحدّث حالة حضوره بس (lastSeen / away / off) في حسابه هو — مش الصلاحية ولا الاسم
    match /users/{email} {
      allow read:  if isAdmin() || (signedIn() && email == myEmail());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isActive() && email == myEmail()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'away', 'off']));
    }

    // الحجوزات: أي حساب نشط يضيف ويعدّل، والمدير بس يحذف
    match /bookings/{id} {
      allow read, create, update: if isActive();
      allow delete: if isAdmin();
    }

    // 🧾 أرشيف المدفوعات (اسكرينات التحويل): بيكتبه بوت تليجرام بس (من GitHub Actions)
    // محدش يقدر يضيف أو يعدّل أو يمسح دفعة من الموقع — عشان رقم الدفعة (P-00001) مايتزوّرش
    match /payments/{pid} {
      allow read:  if isActive();
      allow write: if false;
    }

    // الإعدادات وإعدادات تليجرم: الكل يقرا، المدير بس يعدّل
    match /meta/{docId} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }
  }
}
